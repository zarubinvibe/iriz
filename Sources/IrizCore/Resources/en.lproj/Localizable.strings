"firstrun.translate.body" = "The second key does the same as dictation, but the text comes out in another language.";
"firstrun.translate.note" = "Translation runs through the same agent as prompts: without it the key does nothing.";
"firstrun.translate.title" = "Say it in Russian, get it in English";
