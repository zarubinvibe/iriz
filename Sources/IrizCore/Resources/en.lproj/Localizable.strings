/* iriz interface, English */
"firstrun.accessibility.body" = "To paste the text into an email or a chat, macOS needs a separate permission. It's called \"Accessibility\".";
"firstrun.accessibility.note" = "Without it I'll still turn your speech into text, but there'll be nowhere to put it. Find iriz in the list that opens and turn on the switch: the system does not let me do it for you: only a human, with their own hands.";
"firstrun.accessibility.title" = "Permission needed to paste text";
"firstrun.agent.body" = "A separate key sends what you say to an outside agent instead of the text field: it turns rambling speech into a finished task and hands the text back.";
"firstrun.agent.note" = "This is where \"it all runs on your Mac\" ends: the agent is a separate program, and what you say goes there. So the mode stays off until you turn it on yourself.\n\nI looked for agents already installed on your Mac. You can skip this and come back to it in Settings.";
"firstrun.agent.title" = "Turn speech into an agent task";
"firstrun.agentConnect" = "Connect";
"firstrun.agentConnected" = "Connected";
"firstrun.agentNotFound" = "No agents found. No big deal: dictation and the layout fix work without one, and you can connect one later in Settings.";
"firstrun.back" = "Back";
"firstrun.changeKey" = "Key taken? Change it";
"firstrun.done" = "Done";
"firstrun.granted" = "Done";
"firstrun.hintAccessibility" = "click here, System Settings will open";
"firstrun.hintInputMonitoring" = "click here, System Settings will open";
"firstrun.hintMicrophone" = "click here";
"firstrun.hintModel" = "click here, about five minutes to download";
"firstrun.inputMonitoring.body" = "macOS calls it \"Input Monitoring\" and warns that I'll be able to see your keystrokes in every app. Those are its words, not mine.";
"firstrun.inputMonitoring.note" = "I need two things: to know you pressed the dictation key, and to notice a phrase typed in the wrong keyboard layout. I see keystrokes only here, on your Mac: I save nothing and send nothing anywhere, and I don't work in password fields at all.\n\nRight after that I'll restart. macOS requires it, nothing is broken.";
"firstrun.inputMonitoring.title" = "One permission left: the keyboard";
"firstrun.microphone.action" = "Allow microphone";
"firstrun.microphone.body" = "Without it I won't hear a word, so let's start there.";
"firstrun.microphone.note" = "The audio is never saved: it lives exactly as long as it takes to work out what you said.";
"firstrun.microphone.title" = "Microphone needed";
"firstrun.model.action" = "Download model";
"firstrun.model.body" = "I turn speech into text right on your Mac, no internet. For that I need a model: half a gigabyte, downloaded once.";
"firstrun.model.note" = "It is deliberately not inside the disk image: the model updates more often than iriz itself. Keep it separate: otherwise an outdated one would ship along with the program.\n\nCarry on while it downloads: you can grant the permissions right now.";
"firstrun.model.title" = "Let's get the speech model";
