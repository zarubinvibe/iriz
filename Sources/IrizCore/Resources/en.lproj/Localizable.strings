/* iriz interface, English */
"firstrun.accessibility.body" = "To paste the text into an email or a chat, macOS needs a separate permission. It's called \"Accessibility\".";
"firstrun.accessibility.note" = "Without it I'll still turn your speech into text, but there'll be nowhere to put it. Find iriz in the list that opens and turn on the switch: the system won't let me do that for you.";
"firstrun.accessibility.title" = "Permission needed to paste text";
"firstrun.agent.body" = "A separate key sends what you say to an outside agent instead of the text field: it turns rambling speech into a finished task and hands the text back.";
"firstrun.agent.note" = "This is where \"it all runs on your Mac\" ends: the agent is a separate program, and what you say goes there. So the mode stays off until you turn it on yourself.\n\nI looked for agents already installed on your Mac. You can skip this and come back to it in Settings.";
"firstrun.agent.title" = "Turn speech into an agent task";
