<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Оба ключа нужны для совместимости: audio-input проверяет Hardened Runtime в macOS 26 Tahoe, чтобы показать приложение в настройках микрофона; microphone — запасной ключ App Sandbox для macOS 14–25. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<!-- Движок распознавания приходит бинарным фреймворком (whisper.cpp, ggml-org).
	     Hardened Runtime включает library validation, и она требует у загружаемого
	     кода тот же Team ID; у самоподписанного удостоверения Team ID нет вовсе,
	     поэтому приложение падало на старте: «different Team IDs». Проверено живьём
	     03.09.2026.
	     Цена честно: entitlement разрешает грузить код, подписанный НЕ нашим
	     удостоверением. Для локальной самоподписи это штатный путь, но для
	     публичного релиза правильное решение другое - настоящий Developer ID,
	     которым подписываются и приложение, и вложенный фреймворк. Тогда этот
	     ключ снимается. Занесено в работу волны публикации. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
