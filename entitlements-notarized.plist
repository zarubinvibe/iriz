<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Права для выпуска, подписанного настоящим Developer ID.
	     Отличие от entitlements.plist ровно одно: тут НЕТ ключа
	     com.apple.security.cs.disable-library-validation.

	     Он нужен был самоподписи: Hardened Runtime требует у загружаемого кода
	     тот же Team ID, а у самодельного удостоверения Team ID нет вовсе, и
	     приложение падало на старте с «different Team IDs». Настоящим
	     Developer ID подписываются и приложение, и вложенный whisper.framework,
	     Team ID у них один, и отключать проверку библиотек больше незачем.
	     Держать ее включенной в публичном выпуске значило бы разрешить
	     подгрузку чужого подписанного кода без нужды. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
</dict>
</plist>
